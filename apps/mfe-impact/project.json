{
  "name": "mfe-impact",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/mfe-impact/src",
  "tags": [
    "scope:frontend",
    "type:remote"
  ],
  "targets": {
    "build": {
      "executor": "@angular-architects/native-federation:build",
      "options": {},
      "configurations": {
        "production": {
          "target": "mfe-impact:esbuild:production"
        },
        "development": {
          "target": "mfe-impact:esbuild:development",
          "dev": true
        }
      },
      "defaultConfiguration": "development"
    },
    "serve": {
      "executor": "@angular-architects/native-federation:build",
      "options": {
        "target": "mfe-impact:serve-original:development",
        "rebuildDelay": 200,
        "dev": true,
        "port": 4303
      }
    },
    "esbuild": {
      "executor": "@angular/build:application",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "dist/apps/mfe-impact",
        "index": "apps/mfe-impact/src/index.html",
        "browser": "apps/mfe-impact/src/main.ts",
        "polyfills": [
          "zone.js",
          "es-module-shims"
        ],
        "tsConfig": "apps/mfe-impact/tsconfig.app.json",
        "styles": [
          "apps/mfe-impact/src/styles.css"
        ],
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/mfe-impact/public"
          }
        ]
      },
      "configurations": {
        "production": {
          "optimization": true,
          "outputHashing": "all",
          "sourceMap": false
        },
        "development": {
          "optimization": false,
          "sourceMap": true
        }
      },
      "defaultConfiguration": "development"
    },
    "serve-original": {
      "executor": "@angular/build:dev-server",
      "options": {
        "buildTarget": "mfe-impact:esbuild:development"
      }
    }
  }
}
