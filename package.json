{
  "name": "ali-super-app",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "nx serve super-shell",
    "start:all": "nx run-many -t serve --projects=super-shell,mfe-commerce,mfe-finance,mfe-games,mfe-impact,mfe-life,mfe-local,mfe-media,mfe-social,mfe-utilities",
    "start:api": "nx serve api-gateway",
    "start:services": "nx run-many -t serve --projects=utility-service,commerce-service,productivity-service,geo-service,social-service,media-service,finance-service,content-service,notification-service,game-service,impact-service",
    "build": "nx run-many -t build",
    "test": "nx run-many -t test",
    "graph": "nx graph",
    "format": "nx format:write",
    "check:catalog": "node tools/check-catalog.mjs",
    "dev": "npm run start:services & npm run start:api & npm run start:all",
    "build:prod": "nx run-many -t build --configuration=production",
    "check": "npm run check:catalog && node tools/check-production.mjs",
    "docker:up": "docker compose up -d postgres redis",
    "docker:down": "docker compose down",
    "build:frontends": "nx run-many -t build --projects=super-shell,mfe-commerce,mfe-finance,mfe-games,mfe-impact,mfe-life,mfe-local,mfe-media,mfe-social,mfe-utilities --configuration=production && node tools/assemble-frontend.mjs",
    "build:backends": "nx run-many -t build --projects=api-gateway,utility-service,commerce-service,productivity-service,geo-service,social-service,media-service,finance-service,content-service,notification-service,game-service,impact-service"
  },
  "dependencies": {
    "@angular/animations": "22.2.1",
    "@angular/common": "22.2.1",
    "@angular/compiler": "22.2.1",
    "@angular/core": "22.2.1",
    "@angular/forms": "22.2.1",
    "@angular/platform-browser": "22.2.1",
    "@angular/router": "22.2.1",
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/microservices": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zone.js": "0.15.1",
    "es-module-shims": "2.6.2",
    "pg": "8.23.1",
    "multer": "2.4.0"
  },
  "devDependencies": {
    "@angular-devkit/core": "22.2.1",
    "@angular-devkit/schematics": "22.2.1",
    "@angular/cli": "22.2.1",
    "@angular/compiler-cli": "22.2.1",
    "@nx/angular": "23.2.1",
    "@nx/js": "23.2.1",
    "@nx/nest": "23.2.1",
    "@nx/node": "23.2.1",
    "nx": "23.2.1",
    "typescript": "6.0.3",
    "@angular/build": "22.2.1",
    "@angular-architects/native-federation": "22.2.1",
    "@types/pg": "8.23.1",
    "@types/multer": "2.3.0",
    "@types/node": "24.5.2",
    "@types/express": "5.0.6"
  }
}
